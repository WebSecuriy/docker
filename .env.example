# Start on Windows loopback. For Kali, use the Windows VMware host-only address.
WEBHOOK_BIND_IP=127.0.0.1
WEBHOOK_HOST_PORT=18080

# baseline = registration only; reject = no redirects; strict = validate and pin every hop.
POLICY=strict
ENABLED_MODES=mlflow,plane
RETURN_BODY=mask
STORE_BODY=mask
READ_BODY=mask
BODY_LIMIT=1024
MAX_RESPONSE_BYTES=65536
DELIVERY_TIMEOUT=3
MAX_REDIRECTS=5
# HTTP is for the isolated lab's internal API. HTTPS always verifies CA and hostname.
ALLOW_HTTP=true
INTERNAL_HEALTH_URL=http://internal:8000/health
REPORT_API_URL=http://internal:8000/reports/alpha
# For Kali: mount a public CA bundle under config/ and set CA_FILE=/config/your-ca.pem.
CA_FILE=

# Disabled safety gate for the isolated synthetic CVE demonstration.  The
# launcher sets these temporarily; do not enable them in a shared deployment.
CVE_DEMO_MODE=none
CVE_DEMO_ACK=
# Version-labelled mock profiles, not installed MLflow/Plane binaries.
MLFLOW_VERSION_PROFILE=v3.13.0-vulnerable
MLFLOW_CVE_AUTH_REQUIRED=false
PLANE_VERSION_PROFILE=v1.3.1-vulnerable
# Required only for the isolated Plane CVE profile.  It must be the exact
# HTTPS first hop owned by the lab receiver, never the internal report URL.
CVE_DEMO_PLANE_ORIGIN=
# none | redact-sensitive | metadata-only.  Applied before Plane log storage.
PLANE_LOG_FILTER=none
